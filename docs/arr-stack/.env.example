# Kopieren nach .env und ausfüllen:  cp .env.example .env && chmod 600 .env

# ExpressVPN → Konto → "Manuelle Konfiguration" → OpenVPN-Zugangsdaten
# (nicht die normalen Anmeldedaten!)
EXPRESSVPN_USER=
EXPRESSVPN_PASSWORD=
VPN_COUNTRY=Germany

# Dein Heimnetz, damit Sonarr/Radarr/mediasort Plex erreichen (z. B. 192.168.1.0/24)
HOME_SUBNET=192.168.1.0/24

# Benutzer, dem die Dateien auf der Freigabe gehören (wie uid/gid in /etc/fstab)
PUID=1000
PGID=1000
